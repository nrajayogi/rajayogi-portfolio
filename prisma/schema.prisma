// Downgrading prisma instead
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Content {
  id        Int      @id @default(1) // Singleton row, always ID 1
  data      String
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  firstName String
  lastName  String
  email     String
  message   String
  status    String   @default("unread") // unread, read
}

model PageView {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  path      String
  userAgent String?
  ipHash    String?  // Anonymized unique visitor ID
  country   String?  // Two-letter country code (e.g., US, GB, IN, NL)
  city      String?
  region    String?
  latitude  Float?
  longitude Float?
  device    String?
  browser   String?
  os        String?
  referrer  String?
  action          String?  // e.g. "Viewed Case Study", "Opened CV Dossier", "Downloaded PDF"
  pageTitle       String?  // Human readable title of accessed content
  isp             String?  // Network / Organization / ISP
  company         String?  // Identified company or trackable application tag (e.g. ASML, Philips)
  durationSeconds Int?     // Active reading time in seconds
  scrollDepth     Int?     // Max percentage scrolled (0-100)
  sessionId       String?  // Recruiter session identifier
}

model Image {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  data      Bytes
  mimeType  String
  filename  String
}
